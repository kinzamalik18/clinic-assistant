# Copy this file to .env and fill in your own values. Never commit .env.

# LLM providers. At least one key is required for the chat and inbox to work.
# Gemini key: https://aistudio.google.com  Groq key: https://console.groq.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Order in which providers are tried. The second one is used if the first fails.
LLM_PROVIDERS=gemini,groq

# Token the staff dashboard uses. Staff endpoints are disabled while this is empty.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_TOKEN=

# SQLite file for the inbox. Relative paths resolve from the backend folder.
DATABASE_PATH=var/clinic.db

# Booking. Times are checked and shown in the clinic's time zone (an IANA name).
CLINIC_TIMEZONE=America/New_York
# Appointments that can run at the same time.
TREATMENT_ROOMS=3

# Set this only when the app runs behind a reverse proxy you trust (most hosting
# platforms). It lets uvicorn read the real client IP for rate limiting.
# FORWARDED_ALLOW_IPS=*
